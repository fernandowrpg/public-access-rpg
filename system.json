{
  "id": "public-access",
  "title": "Public Access",
  "description": "Sistema não-oficial para jogar Public Access (PbtA) no Foundry VTT: ficha de Latchkey automatizada, moves básicos, Latchkey moves customizáveis, Keys, Conditions, Dawn Questions e XP.",
  "version": "1.5.0",
  "authors": [
    {
      "name": "Fernando"
    }
  ],
  "compatibility": {
    "minimum": "13",
    "verified": "14"
  },
